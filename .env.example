# ---------- Database ----------
# Use URL-safe characters in the password (letters, digits, - and _).
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=change_me_to_a_long_random_value
POSTGRES_DB=nexus_db

# Used when running the backend directly with `node server.js` (VS Code, local dev).
# Inside docker compose this value is built automatically from the POSTGRES_* variables.
DATABASE_URL=postgresql://nexus_user:change_me_to_a_long_random_value@localhost:5432/nexus_db

# ---------- Backend ----------
PORT=5000
# Comma-separated list of allowed browser origins. Example: http://localhost:3000,http://my-env.elasticbeanstalk.com
CORS_ORIGIN=http://localhost:3000
# Protects POST /api/alerts/:id/ack, /explain and /api/ai/test. Leave empty only for a public demo.
ADMIN_TOKEN=
RETENTION_DAYS=10

# ---------- AI (optional) ----------
# Without these two values the dashboard runs in honest "rules only" mode.
GEMINI_API_KEY=
# Copy a currently available model ID from Google AI Studio. It is intentionally not hardcoded.
GEMINI_MODEL=
AI_MAX_CALLS_PER_HOUR=30
